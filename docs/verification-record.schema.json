{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hobby-eng/multi-chain-wallet-tools/blob/main/docs/verification-record.schema.json",
  "title": "Multi-Chain Wallet Tools verification record",
  "type": "object",
  "required": ["schema", "schemaVersion", "project", "version", "sourceDate", "commit", "dirty", "sourceFingerprint", "verification", "toolchain", "artifacts", "wasm", "attestation"],
  "properties": {
    "schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "project": { "const": "multi-chain-wallet-tools" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceDate": { "type": "string", "format": "date" },
    "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|unavailable)$" },
    "dirty": { "type": "boolean" },
    "sourceFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verification": { "type": "object" },
    "toolchain": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 8, "maxItems": 8 },
    "wasm": { "type": "array", "minItems": 1 },
    "attestation": { "type": "object" }
  },
  "additionalProperties": false
}
