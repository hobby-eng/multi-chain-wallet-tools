* text=auto eol=lf

# Binary inputs must never undergo line-ending or encoding normalization.
*.wasm -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.woff -text
*.woff2 -text

# Licence texts kept byte for byte as the crates ship them; some use CRLF line endings.
LINKED_LICENSES.txt -text
