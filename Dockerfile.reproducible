FROM buildpack-deps:noble@sha256:c2881ab5b526bc3b377a9501a89fec7a82c84f57e89d6cfd2fb9b5cbff75ef7f AS toolchain

ARG NODE_VERSION=24.20.0
ARG NODE_ARCHIVE_SHA256=2f2c0da162318f0de47665410c7c8c2ed3d36c8f3105de4bbc61176c70a7cbf2
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_INIT_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ARG CLANG_VERSION=1:18.0-59~exp2
ARG WASI_LIBC_VERSION=0.0~git20230113.4362b18-3

RUN apt-get update \
    && apt-get install --yes --no-install-recommends "clang=${CLANG_VERSION}" "wasi-libc=${WASI_LIBC_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    PATH=/root/.cargo/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    CI=true \
    CFLAGS_wasm32_unknown_unknown="-I/usr/include/wasm32-wasi -include /usr/include/wasm32-wasi/string.h"

RUN curl --fail --silent --show-error --location \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      --output /tmp/node.tar.xz \
    && echo "${NODE_ARCHIVE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict \
    && tar --extract --xz --file /tmp/node.tar.xz --directory /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && node --version \
    && npm --version

RUN curl --fail --silent --show-error --location \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
      --output /tmp/rustup-init \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum --check --strict \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain 1.98.1 --target wasm32-unknown-unknown \
    && rm /tmp/rustup-init \
    && cargo --version \
    && rustc --version

RUN git config --system http.version HTTP/1.1 \
    && npm install --global pnpm@11.25.0 \
    && cargo install wasm-bindgen-cli --version 0.2.128 --locked \
    && test "$(pnpm --version)" = '11.25.0' \
    && test "$(cargo --version | cut -d ' ' -f 1-2)" = 'cargo 1.98.1' \
    && test "$(wasm-bindgen --version | cut -d ' ' -f 1-2)" = 'wasm-bindgen 0.2.128'

FROM toolchain AS dependencies
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile \
    && for attempt in 1 2 3 4 5; do \
         cargo fetch --manifest-path packages/dash-shielded-wasm/rust/Cargo.toml --locked \
           && cargo fetch --manifest-path packages/recovery-shamir-wasm/rust/Cargo.toml --locked \
           && cargo fetch --manifest-path packages/recovery-codex32-wasm/rust/Cargo.toml --locked \
           && cargo fetch --manifest-path packages/recovery-sskr-wasm/rust/Cargo.toml --locked \
           && cargo fetch --manifest-path packages/recovery-envelope-wasm/rust/Cargo.toml --locked \
           && break; \
         if [ "$attempt" = 5 ]; then exit 1; fi; \
         echo "Cargo fetch attempt ${attempt} failed; retrying in $((attempt * 5)) seconds." >&2; \
         rm -rf \
           "${CARGO_HOME}/git/db/orchard-"* \
           "${CARGO_HOME}/git/checkouts/orchard-"* \
           "${CARGO_HOME}/git/db/zcash_note_encryption-"* \
           "${CARGO_HOME}/git/checkouts/zcash_note_encryption-"*; \
         sleep "$((attempt * 5))"; \
       done
RUN mkdir -p /tmp/committed-generated/dash /tmp/committed-generated/shamir /tmp/committed-generated/codex32 /tmp/committed-generated/sskr /tmp/committed-generated/envelope \
    && cp -a packages/dash-shielded-wasm/generated/. /tmp/committed-generated/dash/ \
    && cp -a packages/recovery-shamir-wasm/generated/. /tmp/committed-generated/shamir/ \
    && cp -a packages/recovery-codex32-wasm/generated/. /tmp/committed-generated/codex32/ \
    && cp -a packages/recovery-sskr-wasm/generated/. /tmp/committed-generated/sskr/ \
    && cp -a packages/recovery-envelope-wasm/generated/. /tmp/committed-generated/envelope/ \
    && cp tooling/wasm-canonical-manifest.json /tmp/committed-generated/wasm-canonical-manifest.json

FROM dependencies AS built
ARG SOURCE_COMMIT=unavailable
ARG SOURCE_DIRTY=false
ENV VERIFICATION_COMMIT=${SOURCE_COMMIT} \
    VERIFICATION_DIRTY=${SOURCE_DIRTY}
RUN --network=none node tooling/build-all-wasm.mjs \
    && node tooling/verify-wasm-integrity.mjs --write
RUN --network=none pnpm verify
# Compile a bounded matrix that exercises every selectable coin and feature at least once.
RUN --network=none pnpm build:matrix:smoke

FROM built AS verified
RUN diff --recursive --brief /tmp/committed-generated/dash packages/dash-shielded-wasm/generated \
    && diff --recursive --brief /tmp/committed-generated/shamir packages/recovery-shamir-wasm/generated \
    && diff --recursive --brief /tmp/committed-generated/codex32 packages/recovery-codex32-wasm/generated \
    && diff --recursive --brief /tmp/committed-generated/sskr packages/recovery-sskr-wasm/generated \
    && diff --recursive --brief /tmp/committed-generated/envelope packages/recovery-envelope-wasm/generated \
    && diff --brief /tmp/committed-generated/wasm-canonical-manifest.json tooling/wasm-canonical-manifest.json

FROM scratch AS artifacts
COPY --from=verified /workspace/dist /dist

FROM scratch AS wasm-artifacts
COPY --from=built /workspace/packages/dash-shielded-wasm/generated /generated/dash
COPY --from=built /workspace/packages/recovery-shamir-wasm/generated /generated/shamir
COPY --from=built /workspace/packages/recovery-codex32-wasm/generated /generated/codex32
COPY --from=built /workspace/packages/recovery-sskr-wasm/generated /generated/sskr
COPY --from=built /workspace/packages/recovery-envelope-wasm/generated /generated/envelope
COPY --from=built /workspace/tooling/wasm-canonical-manifest.json /generated/wasm-canonical-manifest.json
