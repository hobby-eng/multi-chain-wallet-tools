FROM buildpack-deps:noble@sha256:cf0b8fb7b19c45ef68523a0c8a32a742b5f2c0839b1e8ca0061f73d6b1a19062 AS toolchain

ARG NODE_VERSION=26.10.0
ARG NODE_ARCHIVE_SHA256=ca70e9e349de048b9522abb3adc05b3bd6f43c5ffd3ec57916c7da292f59f022
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_INIT_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ARG CLANG_VERSION=1:18.0-59~exp2
ARG WASI_LIBC_VERSION=0.0~git20230113.4362b18-3

RUN apt-get update \
    && apt-get install --yes --no-install-recommends "clang=${CLANG_VERSION}" "wasi-libc=${WASI_LIBC_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    PATH=/root/.cargo/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    CI=true \
    CFLAGS_wasm32_unknown_unknown="-I/usr/include/wasm32-wasi -include /usr/include/wasm32-wasi/string.h"

RUN curl --fail --silent --show-error --location \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      --output /tmp/node.tar.xz \
    && echo "${NODE_ARCHIVE_SHA256}  /tmp/node.tar.xz" | sha256sum --check --strict \
    && tar --extract --xz --file /tmp/node.tar.xz --directory /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && node --version \
    && npm --version

COPY tooling/toolchain-pins.json /tmp/toolchain-pins.json

RUN rust_version="$(node -p 'require("/tmp/toolchain-pins.json").rust')" \
    && curl --fail --silent --show-error --location \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
      --output /tmp/rustup-init \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum --check --strict \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain "${rust_version}" --target wasm32-unknown-unknown \
    && rm /tmp/rustup-init \
    && cargo --version \
    && rustc --version

COPY package.json /tmp/build-package.json
# Cargo's HTTP/2 registry requests stalled in the container while HTTPS curl worked.
# Keep its transport on HTTP/1.1 and compile one crate at a time.
ENV CARGO_HTTP_MULTIPLEXING=false \
    CARGO_BUILD_JOBS=1
RUN package_manager="$(node -p 'require("/tmp/build-package.json").packageManager')" \
    && rust_version="$(node -p 'require("/tmp/toolchain-pins.json").rust')" \
    && bindgen_version="$(node -p 'require("/tmp/toolchain-pins.json").wasmBindgen')" \
    && git config --system http.version HTTP/1.1 \
    && npm install --global "${package_manager}" \
    && cargo install wasm-bindgen-cli --version "${bindgen_version}" --locked \
    && test "$(pnpm --version)" = "${package_manager#pnpm@}" \
    && test "$(cargo --version | cut -d ' ' -f 1-2)" = "cargo ${rust_version}" \
    && test "$(wasm-bindgen --version)" = "wasm-bindgen ${bindgen_version}"

FROM toolchain AS dependencies
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile \
    && for attempt in 1 2 3 4 5; do \
         node tooling/wasm-catalog.mjs fetch \
           && break; \
         if [ "$attempt" = 5 ]; then exit 1; fi; \
         echo "Cargo fetch attempt ${attempt} failed; retrying in $((attempt * 5)) seconds." >&2; \
         rm -rf \
           "${CARGO_HOME}/git/db/orchard-"* \
           "${CARGO_HOME}/git/checkouts/orchard-"* \
           "${CARGO_HOME}/git/db/zcash_note_encryption-"* \
           "${CARGO_HOME}/git/checkouts/zcash_note_encryption-"*; \
         sleep "$((attempt * 5))"; \
       done
RUN node tooling/wasm-catalog.mjs snapshot /tmp/committed-generated

FROM dependencies AS wasm-built
ARG SOURCE_COMMIT=unavailable
ARG SOURCE_DIRTY=false
ENV VERIFICATION_COMMIT=${SOURCE_COMMIT} \
    VERIFICATION_DIRTY=${SOURCE_DIRTY} \
    WALLET_TOOLS_CANONICAL_WASM=1
RUN --network=none node tooling/build-all-wasm.mjs \
    && node tooling/verify-wasm-integrity.mjs --write \
    && node tooling/wasm-catalog.mjs snapshot /tmp/wasm-artifacts

FROM wasm-built AS built
RUN --network=none pnpm verify
# Compile a bounded matrix that exercises every selectable coin and feature at least once.
RUN --network=none pnpm build:matrix:smoke

FROM built AS verified
RUN node tooling/wasm-catalog.mjs verify /tmp/committed-generated

FROM scratch AS artifacts
COPY --from=verified /workspace/dist /dist

FROM scratch AS wasm-artifacts
COPY --from=wasm-built /tmp/wasm-artifacts /generated
