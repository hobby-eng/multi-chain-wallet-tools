{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "paths": {
      "@ckd/core/*": ["./packages/crypto-core/src/*"],
      "@ckd/coins/*": ["./packages/coin-protocols/src/coins/*"],
      "@ckd/export/*": ["./packages/export-core/src/*"],
      "@ckd/dash-network/*": ["./packages/dash-network/src/*"],
      "@ckd/dash-wasm/*": ["./packages/dash-shielded-wasm/generated/*"],
      "@ckd/editions": ["./packages/edition-profiles/src/index.ts"],
      "@ckd/public-data-providers/*": ["./packages/public-data-providers/src/*"],
      "@ckd/secret-boundary/*": ["./packages/secret-boundary/src/*"],
      "@ckd/network-boundary/*": ["./packages/network-boundary/src/*"],
      "@ckd/ui/*": ["./packages/shared-ui/src/*"],
      "@ckd/secret-vault/*": ["./packages/secret-vault/src/*"],
      "@ckd/recovery/*": ["./packages/wallet-recovery/src/*"],
      "@ckd/recovery-backup/*": ["./packages/recovery-backup/src/*"],
      "@ckd/recovery-sskr-wasm/*": ["./packages/recovery-sskr-wasm/generated/*"],
      "@ckd/recovery-envelope-wasm/*": ["./packages/recovery-envelope-wasm/generated/*"],
      "@ckd/recovery-mhfe-wasm/*": ["./packages/recovery-mhfe-wasm/generated/*"],
      "@ckd/recovery-shamir-wasm/*": ["./packages/recovery-shamir-wasm/generated/*"],
      "@ckd/build-info": ["./packages/build-security/src/build-info.ts"],
      "@ckd/self-test": ["./packages/verification/src/self-test.ts"],
      "@ckd/self-test-types": ["./packages/verification/src/types.ts"],
      "@ckd/bip39-self-test": ["./packages/verification/src/bip39-self-test.ts"],
      "@ckd/derivation-self-test": ["./packages/verification/src/derivation-self-test.ts"],
      "@ckd/dash-derivation-self-test": ["./packages/verification/src/derivation-self-test-dash.ts"],
      "@ckd/test-support/*": ["./test/support/*"],
      "@ckd/recovery-codex32-wasm/*": ["./packages/recovery-codex32-wasm/generated/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
